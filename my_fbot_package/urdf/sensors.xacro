<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="camera" params="parent_link">
   
        <link name="camera_link">

            <visual>
                <geometry>
                    <cylinder radius="0.025" length="0.04"/>
                </geometry>
                <material name="green"/>
            </visual>

            <collision>
                <geometry>
                    <cylinder radius="0.025" length="0.04"/>
                </geometry>
            </collision>

            <inertial>
                <origin xyz="0 0 0"/>
                <mass value="0.25"/>
                <inertia ixx="0.0002" iyy="0.0002" izz="0.0002" ixy="0" ixz="0" iyz="0"/>
            </inertial>

        </link>

        <joint name="camera_joint" type="fixed">

            <parent link="${parent_link}"/>
            <child link="camera_link"/>
            <origin xyz="0.25 0 0.15" rpy="0 1.5708 0"/>
            
        </joint>

    </xacro:macro>

    <xacro:macro name="lidar" params="parent_link">

        <link name="lidar_link">
      
            <visual>
                <geometry>
                    <cylinder radius="0.05" length="0.04"/>
                </geometry>
                <material name="blue"/>
            </visual>

            <collision>
                <geometry>
                    <cylinder radius="0.05" length="0.04"/>
                </geometry>
            </collision>

            <inertial>
                <origin xyz="0 0 0"/>
                <mass value="0.5"/>
                <inertia ixx="0.0005" iyy="0.0005" izz="0.0005" ixy="0" ixz="0" iyz="0"/>
            </inertial>

        </link>

        <joint name="lidar_joint" type="fixed">

            <parent link="${parent_link}"/>
            <child link="lidar_link"/>
            <origin xyz="0 0 0.20" rpy="0 0 0"/>

        </joint>

    </xacro:macro>
</robot>
