<?xml version="1.0"?>
<robot name="fbot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="controllers_file" default=""/>    

    <xacro:include filename="materials.xacro"/>
    <xacro:include filename="base.xacro"/>
    <xacro:include filename="wheels.xacro"/>
    <xacro:include filename="sensors.xacro"/>
    <xacro:include filename="ros2_control.xacro"/>
    <xacro:include filename="gazebo.xacro"/>

    <xacro:gazebo controllers_file="$(arg controllers_file)"/>

    <xacro:base_link/>

    <xacro:camera parent_link="base_link"/>

    <xacro:lidar parent_link="base_link"/>
 
    <xacro:wheel wheel_name="front_left_wheel_link" wheel_joint="front_left_wheel_joint" x="0.13" y="0.225"/>

    <xacro:wheel wheel_name="rear_left_wheel_link" wheel_joint="rear_left_wheel_joint" x="-0.13" y="0.225"/>

    <xacro:wheel wheel_name="front_right_wheel_link" wheel_joint="front_right_wheel_joint" x="0.13" y="-0.225"/>

    <xacro:wheel wheel_name="rear_right_wheel_link" wheel_joint="rear_right_wheel_joint" x="-0.13" y="-0.225"/>

    <xacro:ros2_control/>

</robot>
